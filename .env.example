# Copy to .env and fill in, then run: docker compose up -d

# Hostname Caddy serves; the gate lives at https://<PUBLIC_HOST>/remote/
PUBLIC_HOST=remote.example.com
# Existing Docker network your Caddy container is on
CADDY_NETWORK=caddy
# Google account that becomes the Guacamole admin (also list it in allowed-emails.txt)
ADMIN_EMAIL=you@example.com

# From the Google Cloud Console OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
