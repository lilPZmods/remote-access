# Copy to .env and fill in, then run: docker compose up -d

# Your No-IP (or other) hostname; the gate lives at https://<PUBLIC_HOST>/remote/
PUBLIC_HOST=remote.example.com

# Pick one:
#   bundled Caddy (gets HTTPS certificates itself; ports 80 and 443 must reach this machine)
COMPOSE_FILE=compose.yaml:compose.caddy.yaml
#   or join a Caddy you already run, on this Docker network
# COMPOSE_FILE=compose.yaml:compose.external-caddy.yaml
# CADDY_NETWORK=caddy

# Google account that becomes the Guacamole admin (also list it in allowed-emails.txt)
ADMIN_EMAIL=you@example.com

# From the Google Cloud Console OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
